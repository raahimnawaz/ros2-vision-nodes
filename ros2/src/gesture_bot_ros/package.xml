<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gesture_bot_ros</name>
  <version>0.1.0</version>
  <description>
    ROS2 wrapper nodes for the gesture_bot perception -> decision -> actuation loop.
    The nodes add no control logic: they import decision.py, actuators.py and
    perception.py unchanged from the main repo and handle only transport,
    parameters, and failsafes.
  </description>
  <maintainer email="raahimtnawaz@gmail.com">Raahim Nawaz</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>gesture_bot_msgs</depend>

  <!-- cv_bridge is deliberately NOT a dependency. It is a compiled extension
       linked against the distro's NumPy (1.26 on Jazzy), while every model this
       repo runs needs NumPy 2 -- opencv-python 5.x requires it outright. Under
       NumPy 2 cv_bridge still imports and then fails per frame with
       "KeyError: 16", so the breakage does not show up until a real image
       arrives. gesture_bot_ros/image_bridge.py does the conversion in numpy
       instead; see its module docstring. -->

  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
